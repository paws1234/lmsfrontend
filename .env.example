# Copy to .env to override the defaults.
#
# Both docker compose and Vue CLI read this file: VUE_APP_* variables are baked
# into the bundle by Vue CLI (see src/axios.js) and the rest are placeholders
# used by docker-compose.yml.

# Address the browser uses to reach the Laravel API.  Must be reachable from the
# machine running the browser, not a compose service name.
VUE_APP_API_BASE_URL=http://localhost:8000/api

# Host port for the dev server.
FRONTEND_PORT=8080

# Set to true on Docker Desktop (Windows/macOS) if hot reload ignores edits.
#WATCHPACK_POLLING=true
